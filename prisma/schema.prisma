datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
}

enum QuoteStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  APARTMENT
  VILLA
  COMMERCIAL
}

enum PropertyCategory {
  RENT
  SALE
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model QuoteRequest {
  id             String      @id @default(cuid())
  service        String
  subService     String?
  fullName       String
  country        String
  phone          String
  email          String
  propertyType   String?
  propertyCategory String?
  dubaiArea      String?
  budget         String?
  bedrooms       Int?
  rentalDuration String?
  travelDate     String?
  travelers      Int?
  message        String?     @db.Text
  status         QuoteStatus @default(NEW)
  locale         String      @default("en")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Property {
  id            String           @id @default(cuid())
  titleEn       String
  titleAr       String
  titleFr       String
  descriptionEn String?          @db.Text
  descriptionAr String?          @db.Text
  descriptionFr String?          @db.Text
  type          PropertyType
  category      PropertyCategory
  furnished     Boolean          @default(false)
  readyToMove   Boolean          @default(true)
  location      String
  bedrooms      Int              @default(0)
  bathrooms     Int              @default(0)
  area          Int              @default(0)
  price         Decimal          @db.Decimal(12, 2)
  currency      String           @default("AED")
  images        String[]
  featured      Boolean          @default(false)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([type, category])
  @@index([featured])
  @@index([active])
}

model Review {
  id        String       @id @default(cuid())
  name      String
  country   String
  rating    Int
  review    String       @db.Text
  photo     String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model Service {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEn       String
  titleAr       String
  titleFr       String
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text
  descriptionFr String?  @db.Text
  icon          String?
  image         String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([order])
}
